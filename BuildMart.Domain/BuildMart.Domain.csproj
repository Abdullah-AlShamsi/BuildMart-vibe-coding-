<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BuildMart.Domain</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Provides the IdentityUser base class only (no EF Core dependency),
         so the Domain layer stays free of infrastructure concerns. -->
    <PackageReference Include="Microsoft.Extensions.Identity.Stores" Version="8.0.8" />
  </ItemGroup>

</Project>
